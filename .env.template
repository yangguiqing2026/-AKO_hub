# ─────────────────────────────────────────────────────────────
# AKO 统一环境变量模板
#
# 使用方法：
#   1. 复制本文件到 D:\AKO_Hub\.env
#   2. 填入各 API Key
#   3. 各 Spoke 通过 core.ako_config 统一读取，不再各自维护 .env
#
# 注意：.env 文件已在 .gitignore 中，不会被提交
# ─────────────────────────────────────────────────────────────

# ━━ LLM API Keys ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# DeepSeek — 结构计算、造价估算、通用推理
DEEPSEEK_API_KEY=

# Moonshot Kimi — 概念设计、风格分析、历史知识
KIMI_API_KEY=

# MiniMax (mimo) — 主模型：创意文案、美学理论
MINIMAX_API_KEY=

# 阿里云 DashScope — 通义千问视觉（qwen-vl）、规范合规校验
ALIYUN_API_KEY=

# 阿里云 DashScope（通义万相图像生成，独立 key）
DASHSCOPE_API_KEY=

# ━━ 本地服务地址 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ollama 本地推理（嵌入模型 + 备用 LLM）
OLLAMA_HOST=http://localhost:11434

# Stable Diffusion WebUI（建筑效果图渲染）
SD_API_URL=http://localhost:7860

# ComfyUI（高级渲染工作流）
COMFYUI_API_URL=http://localhost:8188

# AKO_chat Web 服务端口
CHAT_PORT=7861

# ━━ Hub 配置 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Hub 根目录（覆盖 hub.yaml 中的 sync_root）
# AKO_HUB_ROOT=E:/数据库_同步百度云盘/BaiduSyncdisk/AKO_Hub

# 知识库运行模式：hub（统一库）/ standalone（独立）
AKO_KNOWLEDGE_MODE=hub

# AKO_knowledge 多机 profile：computer_a / computer_b
# AKO_PROFILE=computer_a

# ━━ 可选 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 腾讯 IMA（知识问答增强，非必需）
# IMA_API_KEY=
# IMA_CLIENT_ID=
